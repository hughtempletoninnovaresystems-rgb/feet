# Neon Postgres
DATABASE_URL=

# Session/rate-limit secret (generate at least 32 random bytes; server-side only)
AUTH_SECRET=

# Google and Facebook OAuth (server-side credentials; keep secrets out of NEXT_PUBLIC_* variables)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v22.0

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Public site origin and draft legal document identifiers
APP_URL=http://localhost:3000
LEGAL_TERMS_VERSION=draft-2026-10-22
LEGAL_PRIVACY_VERSION=draft-2026-10-22

# Keep both disabled until all legal, provider, moderation, payment, and operational gates pass
PUBLIC_SIGNUPS_ENABLED=false
MARKETPLACE_LAUNCH_READY=false
LEGAL_SIGNOFF_COMPLETE=false
UK_AGE_ASSURANCE_SIGNED_OFF=false
MODERATION_OPERATIONS_READY=false
CONTENT_SCANNING_READY=false

# Didit Age Estimation / Adaptive Age Verification (server-side only)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Per-destination secret_shared_key from the Didit webhook destination
DIDIT_WEBHOOK_SECRET=

# ForumPay is selected for underwriting. No checkout or payout is enabled until approval and integration sign-off.
PAYMENT_PROVIDER=forumpay
# Sandbox API HTTP Basic credentials from ForumPay API Settings (not dashboard login)
FORUMPAY_API_USERNAME=
FORUMPAY_API_PASSWORD=
FORUMPAY_POS_ID=
# Preview-only test checkout. Test credits never fund real wallets.
FORUMPAY_SANDBOX_CHECKOUT_ENABLED=false
FORUMPAY_RECONCILIATION_SECRET=
PAYMENT_PROVIDER_APPROVED=false
PAYMENT_INTEGRATION_READY=false

# Amazon S3 (use a private bucket; serve through short-lived signed URLs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Twilio Video (access tokens must be minted server-side)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_VIDEO_API_KEY_REGION=us1
