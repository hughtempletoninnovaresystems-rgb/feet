# Neon Postgres
DATABASE_URL=

# Session/rate-limit secret (generate at least 32 random bytes; server-side only)
AUTH_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Public site origin and draft legal document identifiers
APP_URL=http://localhost:3000
LEGAL_TERMS_VERSION=draft-2026-10-22
LEGAL_PRIVACY_VERSION=draft-2026-10-22

# Keep both disabled until all legal, provider, moderation, payment, and operational gates pass
PUBLIC_SIGNUPS_ENABLED=false
MARKETPLACE_LAUNCH_READY=false

# Didit Age Estimation / Adaptive Age Verification (server-side only)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Per-destination secret_shared_key from the Didit webhook destination
DIDIT_WEBHOOK_SECRET=

# Payments and payouts are disabled. Do not configure Stripe for adult services without written approval.

# Amazon S3 (use a private bucket; serve through short-lived signed URLs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Twilio Video (access tokens must be minted server-side)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
