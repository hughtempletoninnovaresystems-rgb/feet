# Neon Postgres
DATABASE_URL=

# Session/rate-limit secret (generate 32+ random bytes; keep server-side only)
AUTH_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=http://localhost:3000
LEGAL_TERMS_VERSION=draft-2026-10-21
LEGAL_PRIVACY_VERSION=draft-2026-10-21
PUBLIC_SIGNUPS_ENABLED=false
MARKETPLACE_LAUNCH_READY=false

# Yoti Age Verification API (server-only credentials; configure after account setup)
YOTI_API_KEY=
YOTI_SDK_ID=

# Payments and payouts are disabled. Stripe is not configured because its
# current policy excludes adult content and adult creator services.

# Amazon S3 (use a private bucket; serve through short-lived signed URLs)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Twilio Video (access tokens must be minted server-side)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
